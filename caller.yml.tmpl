name: ready-when-green

# Fires after any listed workflow finishes; the reusable workflow re-checks the whole
# check set, so the last workflow to finish is the one that flips the PR to ready.
on:
  workflow_run:
    workflows: [__WORKFLOWS__]
    types: [completed]
  check_suite:
    types: [completed]
  workflow_dispatch:
    inputs:
      pr:
        description: Positive draft pull request number to re-check and mark ready when green
        required: true
        type: string

jobs:
  ready:
    permissions:
      contents: write
      pull-requests: write
      checks: read
      statuses: read
    uses: __CENTRAL__/.github/workflows/ready-when-green.yml@__REF__
